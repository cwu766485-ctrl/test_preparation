#!/bin/csh
# 在 Synthesis/ 执行：csh run
if ( ! -e ../exam_config.csh ) then
    echo "ERROR: ../exam_config.csh 不存在。"
    exit 1
endif
source ../exam_config.csh
if ( "$TOP" == "X" ) then
    echo "ERROR: 先编辑 ../exam_config.csh。"
    exit 1
endif
if ( ! -e "scripts/$TOP.tcl" ) then
    echo "ERROR: 先把顶层综合脚本改名为 scripts/$TOP.tcl，并核对脚本中的顶层模块名。"
    exit 1
endif
if ( ! -e scripts/run_topdown.tcl ) then
    echo "ERROR: 找不到 scripts/run_topdown.tcl"
    exit 1
endif
grep -F -q "$TOP.tcl" scripts/run_topdown.tcl
if ( $status != 0 ) then
    echo "ERROR: run_topdown.tcl 尚未引用 $TOP.tcl"
    exit 1
endif

# 把所有设计 RTL 放到 sources/，并生成读取清单；不读 testbench。
foreach f ( $RTL_FILES )
    if ( ! -e "../Behavioral/$f" ) then
        echo "ERROR: Behavioral/$f 不存在"
        exit 1
    endif
    cp "../Behavioral/$f" sources/
    if ( $status != 0 ) exit 1
end
echo "# Generated by Synthesis/run" > scripts/ReadVerilogFiles.tcl
foreach f ( $RTL_FILES )
    echo "read_verilog ./sources/$f" >> scripts/ReadVerilogFiles.tcl
end
echo "将要读入的 RTL："
cat scripts/ReadVerilogFiles.tcl

# 与 GUI 使用同一个 run_topdown.tcl。考试前需在机房验证批处理兼容性。
echo 'source scripts/run_topdown.tcl' > run_exam_batch.tcl
echo 'exit' >> run_exam_batch.tcl
set BACKUP = "netlist/previous_$$"
mkdir -p "$BACKUP"
foreach ext ( v sdf sdc )
    if ( -e "netlist/Syn_$TOP.$ext" ) mv "netlist/Syn_$TOP.$ext" "$BACKUP/"
end
if ( -e logs/report.rpt ) mv logs/report.rpt "$BACKUP/"
source synopsys_linux_vR_2020_cshrc
dc_shell-xg-t -f run_exam_batch.tcl >& logs/run_exam_syn.log
if ( $status != 0 ) then
    echo "ERROR: 综合命令失败；查看 logs/run_exam_syn.log"
    exit 1
endif
if ( ! -e "netlist/Syn_$TOP.v" || ! -e "netlist/Syn_$TOP.sdf" ) then
    echo "ERROR: 没生成 Syn_$TOP.v / .sdf；查看 logs/run_exam_syn.log"
    exit 1
endif
echo "T2 完成：查看 netlist/Syn_$TOP.*、logs/report.rpt、logs/run_exam_syn.log。"
